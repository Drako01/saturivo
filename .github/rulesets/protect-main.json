{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": false,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Verify (ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "Verify (windows-latest)",
            "integration_id": 15368
          },
          {
            "context": "Verify (macos-latest)",
            "integration_id": 15368
          },
          {
            "context": "Local k6 integration (Linux)",
            "integration_id": 15368
          },
          {
            "context": "Real VS Code Extension Host (Linux)",
            "integration_id": 15368
          },
          {
            "context": "Real Go race and pprof fixture (Linux)",
            "integration_id": 15368
          },
          {
            "context": "Control Center browser interactions (no screenshots)",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
